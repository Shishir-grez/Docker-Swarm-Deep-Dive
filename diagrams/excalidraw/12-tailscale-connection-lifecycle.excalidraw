      "text": "1  Control plane\n\nnetmap: peer's key,\nendpoints, home DERP",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b3",
      "originalText": "1  Control plane\n\nnetmap: peer's key,\nendpoints, home DERP",
