      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563131112,
      "link": null,
      "locked": false,
      "text": "2  Talk via DERP\n\nfirst packets flow at once\nthrough the peer's relay",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b4",
      "originalText": "2  Talk via DERP\n\nfirst packets flow at once\nthrough the peer's relay",
