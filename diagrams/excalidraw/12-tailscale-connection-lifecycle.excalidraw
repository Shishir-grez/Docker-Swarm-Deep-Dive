      "updated": 1794563131112,
      "link": null,
      "locked": false,
      "text": "Every minute Tailscale tries again for a better direct path. If NO path ever answers (hard NAT on both sides, UDP blocked),\ntraffic simply stays on DERP: slower, but it works. `tailscale status` shows \"active; direct <addr>\" or \"active; relay <region>\".",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b19",
      "originalText": "Every minute Tailscale tries again for a better direct path. If NO path ever answers (hard NAT on both sides, UDP blocked),\ntraffic simply stays on DERP: slower, but it works. `tailscale status` shows \"active; direct <addr>\" or \"active; relay <region>\".",
      "autoResize": true,
      "lineHeight": 1.25
    }
