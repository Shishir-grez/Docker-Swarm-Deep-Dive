      "link": null,
      "locked": false,
      "text": "outer packet (what the cloud sees): src = the peer's PUBLIC IP, UDP 41641 or DERP over TCP 443, encrypted",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "outer packet (what the cloud sees): src = the peer's PUBLIC IP, UDP 41641 or DERP over TCP 443, encrypted",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t13",
      "type": "text",
