      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563149439,
      "link": null,
      "locked": false,
      "text": "inner packet (what ufw sees after decryption): src 100.x.y.z, dst 2377/tcp",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "inner packet (what ufw sees after decryption): src 100.x.y.z, dst 2377/tcp",
      "autoResize": true,
      "lineHeight": 1.25
