      "link": null,
      "locked": false,
      "text": "Cloud VPC firewall\nsees: UDP from the peer's\nPUBLIC IP, encrypted.\nA rule for 100.64.0.0/10\nnever matches.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b4",
      "originalText": "Cloud VPC firewall\nsees: UDP from the peer's\nPUBLIC IP, encrypted.\nA rule for 100.64.0.0/10\nnever matches.",
      "autoResize": true,
      "lineHeight": 1.25
    },
