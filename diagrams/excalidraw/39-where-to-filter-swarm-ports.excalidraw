      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563149440,
      "link": null,
      "locked": false,
      "text": "host firewall (ufw)\nsees: src 100.x, dst 2377/tcp\nufw allow in on tailscale0\nto any port 2377 proto tcp",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b7",
      "originalText": "host firewall (ufw)\nsees: src 100.x, dst 2377/tcp\nufw allow in on tailscale0\nto any port 2377 proto tcp",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "M8HiBjsbIkdFaCKBZULOq",
      "type": "text",
      "x": 60.8707275390625,
      "y": 412.25,
      "width": 498.258544921875,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 9043313,
      "version": 3,
      "versionNonce": 1381500575,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563149440,
      "link": null,
      "locked": false,
      "text": "Do NOT open 2377 / 7946 / 4789 in the cloud firewall.\nOptional: allow inbound UDP 41641 so Tailscale can connect directly.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b14",
      "originalText": "Do NOT open 2377 / 7946 / 4789 in the cloud firewall.\nOptional: allow inbound UDP 41641 so Tailscale can connect directly.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
