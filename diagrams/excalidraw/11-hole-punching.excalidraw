      "boundElements": null,
      "updated": 1794563130507,
      "link": null,
      "locked": false,
      "text": "In Tailscale the \"ping/pong\" are small \"disco\" messages sent to every candidate endpoint, and a CallMeMaybe message (relayed via DERP) makes the peer start probing too.\nWireGuard traffic switches to the first path that answers.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b28",
      "originalText": "In Tailscale the \"ping/pong\" are small \"disco\" messages sent to every candidate endpoint, and a CallMeMaybe message (relayed via DERP) makes the peer start probing too. WireGuard traffic switches to the first path that answers.",
      "autoResize": true,
      "lineHeight": 1.25
    }
