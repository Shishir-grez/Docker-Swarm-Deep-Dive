      "text": "adds ~50 bytes per packet + CPU for wrap/unwrap. Placing chatty replicas on one node (placement constraints) avoids it; Swarm does not do this for you.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "adds ~50 bytes per packet + CPU for wrap/unwrap. Placing chatty replicas on one node (placement constraints) avoids it; Swarm does not do this for you.",
      "autoResize": true,
      "lineHeight": 1.25
    },
