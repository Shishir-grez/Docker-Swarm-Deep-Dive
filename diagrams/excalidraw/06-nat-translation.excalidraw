      "boundElements": null,
      "updated": 1794563127660,
      "link": null,
      "locked": false,
      "text": "1 PC sends   2 router swaps in its public IP + a fresh port, records the pair   3 reply arrives at that port   4 router swaps the PC back in.\nA packet for a port with NO entry (red) has no owner inside, so it is dropped.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b29",
      "originalText": "1 PC sends   2 router swaps in its public IP + a fresh port, records the pair   3 reply arrives at that port   4 router swaps the PC back in.\nA packet for a port with NO entry (red) has no owner inside, so it is dropped.",
      "autoResize": true,
      "lineHeight": 1.25
    }
