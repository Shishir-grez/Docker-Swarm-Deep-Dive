      "link": null,
      "locked": false,
      "text": "TASK = one running copy\n(also called a replica): web.1  web.2  web.3\nSwarm places each on a node",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b20",
      "originalText": "TASK = one running copy\n(also called a replica): web.1  web.2  web.3\nSwarm places each on a node",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
