      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563132957,
      "link": null,
      "locked": false,
      "text": "If a node dies, the manager notices and starts its tasks elsewhere: that is \"desired state\". db.1 is a different service with 1 replica.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b23",
      "originalText": "If a node dies, the manager notices and starts its tasks elsewhere: that is \"desired state\". db.1 is a different service with 1 replica.",
      "autoResize": true,
      "lineHeight": 1.25
    }
