    {
      "id": "tFYR2u34fW1yhunTAusDM",
      "type": "text",
      "x": 78.1651611328125,
      "y": 416.75,
      "width": 1023.669677734375,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 1250350815,
      "version": 3,
      "versionNonce": 241806207,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563128875,
      "link": null,
      "locked": false,
      "text": "Port forwarding on YOUR router (NAT #1) is useless: the packet is dropped at the ISP's NAT (#2) before it reaches you.\nSo friends behind CGNAT must connect OUTWARD: to a relay, or to each other at the same moment (hole punching).",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b21",
      "originalText": "Port forwarding on YOUR router (NAT #1) is useless: the packet is dropped at the ISP's NAT (#2) before it reaches you.\nSo friends behind CGNAT must connect OUTWARD: to a relay, or to each other at the same moment (hole punching).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AP9Xjo4qBbi32WTvRm6_Z",
      "type": "text",
      "x": 21.7587890625,
      "y": 524,
      "width": 1136.482421875,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 979804927,
      "version": 3,
      "versionNonce": 653791217,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563128875,
      "link": null,
      "locked": false,
      "text": "Spot it: hops in your traceroute (and your router's WAN address) inside 100.64.0.0/10. Tailscale ALSO uses 100.64.0.0/10 for its own addresses;\nby default its Linux client drops incoming CGNAT-range packets that are not from Tailscale, so the two do not collide.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b22",
      "originalText": "Spot it: hops in your traceroute (and your router's WAN address) inside 100.64.0.0/10. Tailscale ALSO uses 100.64.0.0/10 for its own addresses;\nby default its Linux client drops incoming CGNAT-range packets that are not from Tailscale, so the two do not collide.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
