      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563147258,
      "link": null,
      "locked": false,
      "text": "A proxy terminates your connection and opens a new one on your behalf. NAT only rewrites headers.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A proxy terminates your connection and opens a new one on your behalf. NAT only rewrites headers.",
      "autoResize": true,
      "lineHeight": 1.25
    },
