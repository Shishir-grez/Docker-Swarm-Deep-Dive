      "link": null,
      "locked": false,
      "text": "Proxies, and why NAT is not one",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proxies, and why NAT is not one",
