      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563144852,
      "link": null,
      "locked": false,
      "text": "Both directions go through a host-side process; the VM itself is never directly addressable from outside.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Both directions go through a host-side process; the VM itself is never directly addressable from outside.",
      "autoResize": true,
      "lineHeight": 1.25
    },
