      "boundElements": null,
      "updated": 1794563144852,
      "link": null,
      "locked": false,
      "text": "The host process opens ordinary TCP/IP sockets, so firewalls, VPNs and proxies see traffic coming from IT, not from a VM.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The host process opens ordinary TCP/IP sockets, so firewalls, VPNs and proxies see traffic coming from IT, not from a VM.",
      "autoResize": true,
      "lineHeight": 1.25
    },
