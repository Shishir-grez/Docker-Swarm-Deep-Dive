      "text": "Docker Desktop: how traffic leaves, and how published ports come in",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Docker Desktop: how traffic leaves, and how published ports come in",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t2",
      "type": "text",
      "x": 0,
      "y": 40,
      "width": 826.1936645507812,
      "height": 20,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
