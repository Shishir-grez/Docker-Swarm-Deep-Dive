      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563143440,
      "link": null,
      "locked": false,
      "text": "VTEP reads the VNI\nfrom the VXLAN header",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b4",
      "originalText": "VTEP reads the VNI\nfrom the VXLAN header",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rCmDj1Xb11XMLB--kPgEi",
      "type": "text",
      "x": 907.7572784423828,
      "y": 134.75,
      "width": 264.4854431152344,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1687828785,
      "version": 3,
      "versionNonce": 599480977,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563143440,
      "link": null,
      "locked": false,
      "text": "VNI 4097  =  overlay \"frontend\"\n->  deliver to frontend br0",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b6",
      "originalText": "VNI 4097  =  overlay \"frontend\"\n->  deliver to frontend br0",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5eSI1ETIaoL0lRzykXOen",
      "type": "text",
      "x": 910.6642761230469,
      "y": 284.75,
      "width": 258.67144775390625,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1010690833,
      "version": 3,
      "versionNonce": 204083967,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563143440,
      "link": null,
      "locked": false,
      "text": "VNI 4098  =  overlay \"backend\"\n->  deliver to backend br0",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b8",
      "originalText": "VNI 4098  =  overlay \"backend\"\n->  deliver to backend br0",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UoRwdXntsj4Ixz7Z-W_uy",
      "type": "text",
      "x": 893.7153015136719,
      "y": 434.75,
      "width": 292.56939697265625,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 743465201,
      "version": 3,
      "versionNonce": 829677681,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563143440,
      "link": null,
      "locked": false,
      "text": "VNI 9999  =  no such network here\n->  discard",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b10",
      "originalText": "VNI 9999  =  no such network here\n->  discard",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RguZ-tj1vkU_cmc_HL9lU",
      "type": "text",
      "x": 206.15689086914062,
      "y": 582.25,
      "width": 877.6862182617188,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 1113135825,
      "version": 3,
      "versionNonce": 948787999,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563143440,
      "link": null,
      "locked": false,
      "text": "Numbers from Docker 29.9.2: ingress = 4096; user overlays 4097, 4098, ... (VNIs are 24-bit, so ~16 million are possible).\nThis check is why a \"frontend\" container cannot see \"backend\" traffic even though both ride the same UDP channel.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b12",
      "originalText": "Numbers from Docker 29.9.2: ingress = 4096; user overlays 4097, 4098, ... (VNIs are 24-bit, so ~16 million are possible).\nThis check is why a \"frontend\" container cannot see \"backend\" traffic even though both ride the same UDP channel.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
