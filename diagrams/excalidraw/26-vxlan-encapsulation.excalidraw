      "text": "VXLAN: wrap the container's whole Ethernet frame inside a UDP packet",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "VXLAN: wrap the container's whole Ethernet frame inside a UDP packet",
