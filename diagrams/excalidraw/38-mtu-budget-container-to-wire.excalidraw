      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563148772,
      "link": null,
      "locked": false,
      "text": "VXLAN overhead 50 = inner Eth 14 + VXLAN 8 + UDP 8 + outer IP 20",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "VXLAN overhead 50 = inner Eth 14 + VXLAN 8 + UDP 8 + outer IP 20",
      "autoResize": true,
      "lineHeight": 1.25
    },
