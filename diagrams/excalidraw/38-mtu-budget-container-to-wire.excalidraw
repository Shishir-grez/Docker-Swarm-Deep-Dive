      "link": null,
      "locked": false,
      "text": "1230 + 50 = 1280 fits tailscale0;  + WireGuard/UDP/IP (up to 80) = 1360 < 1500: OK",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1230 + 50 = 1280 fits tailscale0;  + WireGuard/UDP/IP (up to 80) = 1360 < 1500: OK",
      "autoResize": true,
      "lineHeight": 1.25
    },
