    {
      "id": "2pUQrggiND9fsXNnVFprD",
      "type": "text",
      "x": 52.75830078125,
      "y": 532.875,
      "width": 1184.4833984375,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 458538815,
      "version": 3,
      "versionNonce": 1856977791,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563148773,
      "link": null,
      "locked": false,
      "text": "Rule of thumb: inner MTU = tailscale0 MTU - 50.  Docker subtracts the 50 itself, so pass the UNDERLAY value (1280): `docker network create -d overlay --opt\ncom.docker.network.driver.mtu=1280 ...`\n(Passing 1230 gives 1180.)  The default `ingress` network needs the same option.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b20",
      "originalText": "Rule of thumb: inner MTU = tailscale0 MTU - 50.  Docker subtracts the 50 itself, so pass the UNDERLAY value (1280): `docker network create -d overlay --opt com.docker.network.driver.mtu=1280 ...`\n(Passing 1230 gives 1180.)  The default `ingress` network needs the same option.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
