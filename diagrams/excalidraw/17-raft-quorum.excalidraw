      "updated": 1794563134368,
      "link": null,
      "locked": false,
      "text": "No heartbeat for ~10 s (Election Tick 10) -> a follower calls an election; a new leader needs\nvotes from a majority.\nWithout a majority the cluster stops accepting changes (this prevents \"split brain\").",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b9",
      "originalText": "No heartbeat for ~10 s (Election Tick 10) -> a follower calls an election; a new leader needs votes from a majority.\nWithout a majority the cluster stops accepting changes (this prevents \"split brain\").",
      "autoResize": true,
      "lineHeight": 1.25
    },
