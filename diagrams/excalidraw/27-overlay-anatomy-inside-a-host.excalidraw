    {
      "id": "t25",
      "type": "text",
      "x": 10,
      "y": 441,
      "width": 1215.923828125,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 2593233,
      "version": 2,
      "versionNonce": 1158041137,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563140601,
      "link": null,
      "locked": false,
      "text": "1  app sends a frame to the MAC of 10.0.1.7   2  veth moves it across the namespace boundary   3  br0 switches by MAC; a remote MAC is behind vxlan0\n4  vxlan0 finds the remote VTEP IP, wraps (UDP 4789, VNI 4097)   5  the HOST routing table picks the egress interface   6  tailscale0 encrypts it and sends it on",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1  app sends a frame to the MAC of 10.0.1.7   2  veth moves it across the namespace boundary   3  br0 switches by MAC; a remote MAC is behind vxlan0\n4  vxlan0 finds the remote VTEP IP, wraps (UDP 4789, VNI 4097)   5  the HOST routing table picks the egress interface   6  tailscale0 encrypts it and sends it on",
      "autoResize": true,
      "lineHeight": 1.25
    },
