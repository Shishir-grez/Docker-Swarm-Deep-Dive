      "versionNonce": 995816561,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563140602,
      "link": null,
      "locked": false,
      "text": "No local/dev is set on vxlan0: the kernel routes the wrapped packet using the host table, so with Tailscale addresses as VTEP IPs it leaves through tailscale0.\nDashed blue = north-south traffic (to the Internet) that never touches VXLAN.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b26",
      "originalText": "No local/dev is set on vxlan0: the kernel routes the wrapped packet using the host table, so with Tailscale addresses as VTEP IPs it leaves through tailscale0.\nDashed blue = north-south traffic (to the Internet) that never touches VXLAN.",
      "autoResize": true,
      "lineHeight": 1.25
    }
