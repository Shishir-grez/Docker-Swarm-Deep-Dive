    },
    {
      "id": "qeoLGdO_ULbpHbPL7vvZ8",
      "type": "text",
      "x": 984.2803421020508,
      "y": 238.25,
      "width": 181.43931579589844,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
