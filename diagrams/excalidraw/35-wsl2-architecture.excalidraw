    {
      "id": "Hcil-VV6v6Nya-K2x0azu",
      "type": "text",
      "x": 17.0579833984375,
      "y": 599.875,
      "width": 1255.884033203125,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 337799633,
      "version": 3,
      "versionNonce": 1416371231,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794563146519,
      "link": null,
      "locked": false,
      "text": "Networking (Microsoft docs): the default mode is NAT: the VM has its own virtual adapter and IP behind Windows (so Tailscale in WSL is behind that NAT too). \"mirrored\"\nmode shares the host's interfaces; \"bridged\" is deprecated since WSL 2.4.5.\nDocker's WSL docs warn that running Docker Desktop and a separate Engine inside WSL can conflict: disable Desktop's WSL integration for this distro.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b17",
      "originalText": "Networking (Microsoft docs): the default mode is NAT: the VM has its own virtual adapter and IP behind Windows (so Tailscale in WSL is behind that NAT too). \"mirrored\" mode shares the host's interfaces; \"bridged\" is deprecated since WSL 2.4.5.\nDocker's WSL docs warn that running Docker Desktop and a separate Engine inside WSL can conflict: disable Desktop's WSL integration for this distro.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
  "appState": {
